{
  "name": "remodex",
  "version": "2.0.0",
  "description": "Local bridge between Codex and the Remodex mobile app. Run `remodex up` to start.",
  "main": "src/index.js",
  "bin": {
    "remodex": "bin/remodex.js",
    "remodex-jsonl-diagnose": "bin/remodex-jsonl-diagnose.js"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "scripts": {
    "start": "node ./bin/remodex.js up",
    "test": "node -r ./test/test-env.js --test --test-force-exit ./test/*.test.js",
    "test:coverage": "node -r ./test/test-env.js --test --test-force-exit --experimental-test-coverage --test-coverage-exclude=test/** --test-coverage-exclude=bin/** ./test/*.test.js",
    "test:opencode": "REMODEX_DISABLE_OPENCODE= node -r ./test/test-env.js --test --test-force-exit ./test/opencode-*.test.js ./test/runtime-merge.test.js ./test/runtime-catalog.test.js ./test/runtime-routing.test.js ./test/provider-capabilities.test.js ./test/opencode-network-failures.test.js ./test/opencode-concurrency.test.js",
    "test:integration": "node -r ./test/test-integration-env.js --test --test-force-exit ./test/opencode-integration.test.js",
    "postinstall": "node ./src/bootstrap-codex-cli.js",
    "postinstall:check-sdk": "node -e \"require.resolve('@opencode-ai/sdk/v2')\"",
    "prepack": "node ./scripts/prepare-private-defaults.js",
    "postpack": "node ./scripts/cleanup-private-defaults.js"
  },
  "keywords": [
    "remodex",
    "codex",
    "bridge",
    "cli"
  ],
  "author": "Emanuele Di Pietro",
  "license": "Apache-2.0",
  "type": "commonjs",
  "dependencies": {
    "@opencode-ai/sdk": "^1.2.10",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.19.0"
  }
}
